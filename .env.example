# Lensiq backend environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# Comma-separated list of allowed CORS origins. Leave unset to disable CORS.
CORS_ORIGIN=http://localhost:3000

# --- Gemini Live (ephemeral token issuing) ---
# Required. API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Number of times an issued ephemeral token can be used.
GEMINI_LIVE_TOKEN_USES=1
# Token lifetime in seconds for signed-in users (default 1800 = 30 min).
GEMINI_LIVE_TOKEN_SECONDS=1800
# Token lifetime in seconds for anonymous/guest users (default 900 = 15 min).
GEMINI_LIVE_GUEST_TOKEN_SECONDS=900
# Window in seconds during which the token can start a new session (default 60).
GEMINI_LIVE_NEW_SESSION_SECONDS=60
# Standard (non-Live) model used for POST /ai/meeting/analyze — transcribes
# recordings and generates the meeting summary/mind-map in one call.
GEMINI_MEETING_MODEL=gemini-flash-latest

# --- Firmware update banner (GET /firmware/latest, unauthenticated) ---
# Optional. Set when a new firmware build ships; the Home screen compares
# this against what the glasses report over BLE. Leave unset to keep the
# banner hidden. Per-device-class override: FIRMWARE_LATEST_VERSION_<CLASS>
# (e.g. FIRMWARE_LATEST_VERSION_ANVEE_X1), falls back to FIRMWARE_LATEST_VERSION.
FIRMWARE_LATEST_VERSION=
FIRMWARE_RELEASE_NOTES=

# --- Feedback (POST /feedback, sign-in required) ---
# Routes submissions over SMTP rather than a database — see
# src/feedback/feedback-mail.service.ts. All required for feedback to work;
# without them the endpoint returns a clear 503 rather than silently no-op'ing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Mailbox that receives feedback submissions.
FEEDBACK_TO_EMAIL=

# --- Firebase Admin (auth verification) ---
# Required. Raw service account JSON on a single line
# (Firebase console -> Project settings -> Service accounts -> Generate new private key).
FIREBASE_SERVICE_ACCOUNT_JSON=
