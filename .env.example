# Lensiq backend environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# Comma-separated list of allowed CORS origins. Leave unset to disable CORS.
CORS_ORIGIN=http://localhost:3000

# --- Gemini Live (ephemeral token issuing) ---
# Required. API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Number of times an issued ephemeral token can be used.
GEMINI_LIVE_TOKEN_USES=1
# Token lifetime in seconds for signed-in users (default 1800 = 30 min).
GEMINI_LIVE_TOKEN_SECONDS=1800
# Token lifetime in seconds for anonymous/guest users (default 900 = 15 min).
GEMINI_LIVE_GUEST_TOKEN_SECONDS=900
# Window in seconds during which the token can start a new session (default 60).
GEMINI_LIVE_NEW_SESSION_SECONDS=60

# --- Firebase Admin (auth verification) ---
# Required. Raw service account JSON on a single line
# (Firebase console -> Project settings -> Service accounts -> Generate new private key).
FIREBASE_SERVICE_ACCOUNT_JSON=
